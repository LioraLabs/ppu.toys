# Cookfile for ppu.toys — a ShaderToy-style web playground for an emulated SNES PPU.
#
# Monorepo shape: a pure, headless Rust core (crates/ppu-core) compiled to WASM via
# wasm-pack, consumed by a React + Vite app (web/) behind the `PpuCore` TS seam;
# plus the site backend, a single axum binary (crates/ppu-server) imported as the
# `server` module below.
#
# DOGFOOD: the web/ pipeline runs through the blessed `cook_pnpm` module (pinned in
# cook.toml, installed to cook_modules/ via `cook modules install`). The repo is a
# one-package pnpm workspace (pnpm-workspace.yaml at the root, package `web`);
# cook_pnpm mints `web:<task>` recipes from web/package.json scripts and keys every
# unit on the pnpm-lock.yaml install probe — node_modules is no longer a cached
# directory output (the old npm `deps` recipe is gone).
#
#   ── build ──────────────────────────────────────────────────────────────────
#   cook             full build (default): WASM module + web/dist + server
#   cook build       same as above
#   cook wasm        (re)build the WASM module into web/src/wasm/pkg
#   cook "web:build" production web build -> web/dist   (minted by cook_pnpm.task)
#   cook install     pnpm install --frozen-lockfile (cached by lockfile hash)
#   cook server.build  compile the axum backend (crates/ppu-server)
#   cook cli         compile the ppu pack/unpack CLI
#   cook cli-install install the ppu pack/unpack CLI locally
#
#   ── run ──────────────────────────────────────────────────────────────────────
#   cook dev         Vite dev server (builds the WASM core first)
#   cook server.run  boot the backend serving web/dist + the live API
#
#   ── component workflow (Cosmos tree + fixtures + MSW) ────────────────────────
#   cook cosmos      Cosmos component tree — dev server, drill into compositions
#   cook "web:catalog"  static catalog build -> web/build (cached, minted)
#   cook shoot       screenshot one story -> web/.shots (STORY=<story-id>)
#   cook dev-offline Vite dev with the whole app mocked by MSW (VITE_MSW=1)
#
#   ── local testing bed (ephemeral db) ───────────────────────────────────────
#   cook stack       backend + studio against build/dev.db (Ctrl-C stops both)
#   cook stack-fresh throw the db away, then run the empty stack
#   cook db-nuke     delete the ephemeral db
#
#   ── deploy/ops (production operations) ────────────────────────────────────
#   cook ship / deploy.rollback / deploy.health / deploy.logs
#
#   ── verify ─────────────────────────────────────────────────────────────────
#   cook test-core   cargo test (core unit + golden framebuffer compare)
#   cook test-web    vitest (cached recipe "web:test" underneath)
#   cook server.test cargo test -p ppu-server (backend suites)
#   cook typecheck   tsc --noEmit (cached recipe "web:typecheck" underneath)
#   cook check       typecheck + all three test suites (pre-commit umbrella)
#   cook fmt         cargo fmt
#
#   ── housekeeping ─────────────────────────────────────────────────────────────
#   cook clean       remove build artifacts (target, dist, wasm pkg, .cook cache)
#   cook distclean   clean + remove node_modules trees
#
# Caching notes:
#   - `wasm` declares its files explicitly (its pkg lives inside web's source tree,
#     so a globbed directory output would collide with web:* `src/**` input globs).
#   - web:* recipes are minted by cook_pnpm.task: inputs are package-relative globs
#     expanded at register time, outputs are post-execute-resolved globs (CS-0085),
#     and each unit seals the pnpm:install:<lockfile-hash> probe — lockfile drift
#     invalidates every web unit; source-only edits invalidate only web:*.
#   - node_modules is owned by the install probe (pnpm install --frozen-lockfile,
#     once per lockfile hash), not restored from the artifact store.
#
# Cook gotcha: one command per line; a multi-step shell line needs `sh -c "a && b"`.

use cook_pnpm

# ── MODULES: the axum backend lives in its own imported Cookfile, referenced
#    as server.build / server.test / server.run. The deploy/ production operations
#    come in as deploy.ship / rollback / health / logs.
import server ./crates/ppu-server
import deploy ./deploy

# ── PNPM WORKSPACE: one call parses pnpm-workspace.yaml + web/package.json,
#    registers the toolchain + install probes, and mints the web:* recipes.
#    - requires = {"wasm"}: every minted task reads the wasm pkg under web/src/
#      (path equality creates no ordering edge in cook — name the producer).
#    - build/catalog declare outputs -> cached cook units, restored on hit.
#    - test/typecheck are auto-minted checks (engine test units): content-
#      fingerprinted, pass results replayed, run by `cook test`.
#    - inputs default to web/'s file tree minus node_modules + declared outputs.
#    Recipe names carry a colon, so they are quoted when referenced below.
register
    cook_pnpm.workspace({
        node     = ">=18",
        pm       = "pnpm@10",       -- mirrors root package.json "packageManager"
        requires = { "wasm" },
        install  = "install",       -- `cook install` = explicit CI staging
        tasks    = {
            -- web:build — tsc + vite build -> web/dist
            build   = { outputs = { "dist/**" } },
            -- web:catalog — static Cosmos export -> web/build
            catalog = { outputs = { "build/**" } },
        },
    })

# ── WASM: rebuild the module only when the Rust core or its manifests change. The
#    files Vite + tsc consume are declared explicitly (so web:* recipes form
#    file-level edges to them). wasm-pack's --out-dir is relative to the crate dir.
#    The core's sources determine the output but are never named on the command
#    line, so they are a sealed `files` set, not a gather (CS-0229).
files wasm:src
    "crates/ppu-core/src/**/*.rs" "crates/ppu-core/Cargo.toml" "Cargo.toml" "Cargo.lock"

recipe wasm
    seal wasm:src
    cook "web/src/wasm/pkg/ppu_core.js"
         "web/src/wasm/pkg/ppu_core_bg.wasm"
         "web/src/wasm/pkg/ppu_core.d.ts"
         "web/src/wasm/pkg/ppu_core_bg.wasm.d.ts" {
        wasm-pack build crates/ppu-core --target web --out-dir ../../web/src/wasm/pkg
    }

# ── CLI: offline pack/unpack between a toy directory and a `.ppu.json` file.
files cli:src
    "crates/ppu-cli/src/**/*.rs" "crates/ppu-cli/Cargo.toml" "Cargo.toml" "Cargo.lock"

recipe cli
    seal cli:src
    cook "target/debug/ppu" { cargo build -p ppu-cli } local

chore cli-install: cli
    cargo install --path crates/ppu-cli

# ── WEB alias: `cook web` still works — wasm first (file-edge ordered), then the
#    minted pnpm build.
recipe web: wasm "web:build"

# ── BUILD: the default target — the whole stack. server.build is an order-only
#    fence (it produces nothing the web build reads) kept so `cook build` compiles
#    the backend too.
recipe build: web server.build cli

# Build locally with Cook's cache, then atomically replace production.
chore ship: web server.release
    deploy/ship.sh

# ── DEV SERVER: long-running, interactive. Builds the WASM core first — the app
#    has no mock fallback, so it can't render without it.
chore dev: wasm install
    pnpm --filter web run dev

# ── DEV (OFFLINE): the same Vite dev server, but MSW intercepts every API call so
#    the whole app boots with no backend — handlers in web/src/mocks serve fixtures.
chore dev-offline: wasm install
    sh -c 'VITE_MSW=1 pnpm --filter web run dev'

# ── COMPONENT WORKFLOW: Cosmos tree (long-running, interactive, hot-reloads).
chore cosmos: wasm install
    pnpm --filter web run cosmos

# ── SHOOT: render one fixture to a PNG under web/.shots for a tight agent visual
#    loop. STORY is required (env-driven, like the deploy chores); the shoot script
#    screenshots the cached `web:catalog` build headlessly via Playwright.
chore shoot: "web:catalog"
    sh -c 'pnpm --filter web run shoot "${STORY:?set STORY=<component-path#variant>, e.g. components/ToyCard#Default}"'

# ── LOCAL DATA: an ephemeral sqlite db under build/ (gitignored). Every local
#    entry point points at it via PPU_DB_PATH; the repo-root ppu.db is no longer
#    anyone's target. There is no separate "create it migrated and empty" step —
#    sqlx runs the migrations on connect, so deletion IS the fresh db.
chore db-nuke
    rm -f build/dev.db build/dev.db-shm build/dev.db-wal

# ── STACK: the local testing bed — backend + studio dev server against the
#    ephemeral db, torn down together on Ctrl-C. `stack-fresh` throws the db away
#    first; content belongs in toy directories and arrives by opening a packed
#    `.ppu.json` in the Studio.
#    The backend backgrounds into the next step and cook drains it when the chore
#    ends — success, failure, or Ctrl-C (COOK-544, cook >= 0.16.1). No trap.
#    server.build is kept for a fast start and so compile errors surface as a
#    build failure, not as a server that never binds.
chore stack: wasm install server.build
    PPU_PORT=18080 PPU_DB_PATH=build/dev.db PPU_DEV_SEED=1 target/debug/ppu-server &
    PPU_API_TARGET=http://127.0.0.1:18080 pnpm --filter web run dev

chore stack-fresh: db-nuke stack

# ── TESTS ────────────────────────────────────────────────────────────────────
chore test-core
    cargo test

chore test-web: "web:test"

chore typecheck: "web:typecheck"

# Pre-commit umbrella: types + all three suites (core, web, backend).
chore check: typecheck test-core test-web server.test

chore fmt
    cargo fmt
    pnpm exec prettier --write --log-level warn .

# ── HOUSEKEEPING ─────────────────────────────────────────────────────────────
chore clean
    rm -rf target web/dist web/build web/.shots web/src/wasm/pkg .cook

chore distclean: clean
    rm -rf node_modules web/node_modules
