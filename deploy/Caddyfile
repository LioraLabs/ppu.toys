# ppu.toys — Caddy terminates TLS (auto Let's Encrypt) and reverse-proxies every
# request to ppu-server on 127.0.0.1:8080. Cloudflare sits in front (proxied);
# this box is the origin. The server serves the SPA + API + blobs itself.

ppu.toys {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.discordapp.com; media-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
	}

	# Owners can republish a toy under the same id, replacing its clip/thumb.
	@blobs path /blobs/*
	header @blobs Cache-Control "public, max-age=60, must-revalidate"

	reverse_proxy 127.0.0.1:8080
}

# Send apex-www to the canonical apex.
www.ppu.toys {
	redir https://ppu.toys{uri} permanent
}
