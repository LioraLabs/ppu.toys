{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ../crates/ppu-core --target web --out-dir ../../web/src/wasm/pkg",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/fixture-ref.node.mjs",
    "cosmos": "cosmos",
    "catalog": "cosmos-export",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-vim": "^6.2.1",
    "codemirror": "^6.0.1",
    "dockview-react": "^7.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.61.1",
    "react-cosmos": "npm:@lioralabs/react-cosmos@7.3.2",
    "react-cosmos-core": "npm:@lioralabs/react-cosmos-core@7.3.2",
    "react-cosmos-plugin-open-fixture": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "react-cosmos-ui": "npm:@lioralabs/react-cosmos-ui@7.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
