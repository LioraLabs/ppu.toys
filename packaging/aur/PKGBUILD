# Maintainer: Alex Gilbert <code@lioralabs.dev>

pkgname=ppu-cli-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Author SNES PPU toys for ppu.toys offline: new, check, render, pack, docs"
arch=('x86_64' 'aarch64')
url="https://github.com/LioraLabs/ppu.toys"
license=('MIT')
provides=('ppu-cli')
conflicts=('ppu-cli')
options=('!strip')

_base="$url/releases/download/v$pkgver"
source_x86_64=("ppu-$pkgver-x86_64.tar.gz::$_base/ppu-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("ppu-$pkgver-aarch64.tar.gz::$_base/ppu-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
	cd "$srcdir/ppu-v$pkgver-$CARCH-unknown-linux-musl"
	install -Dm755 ppu "$pkgdir/usr/bin/ppu"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
